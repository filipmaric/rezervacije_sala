# Copy this file to /var/www/rezervacije/rezervacije.env and fill in the real values.

APP_ENV=production
APPLICATION_ROOT=/rezervacije
STATIC_URL_PATH=/rezervacije/static

# Teacher authentication
TEACHER_AUTH_BACKEND=radius
TEACHER_RADIUS_SERVER=147.91.66.2
TEACHER_RADIUS_SECRET=replace_with_teacher_radius_secret
TEACHER_RADIUS_DICTIONARY=/var/www/rezervacije/radius/dictionary

# Student authentication
STUDENT_AUTH_BACKEND=radius
STUDENT_RADIUS_SERVER=replace_with_student_radius_server
STUDENT_RADIUS_SECRET=replace_with_student_radius_secret
STUDENT_RADIUS_DICTIONARY=/var/www/rezervacije/radius/dictionary

# Application secrets
SECRET_KEY=replace_with_flask_secret_key
SERVICE_API_KEY=replace_with_service_api_key
ATTENDANCE_SECRET=replace_with_attendance_secret
ATTENDANCE_ALLOWED_LOCATIONS=[{"name":"MATF 1","latitude":44.8200177330261,"longitude":20.45871822883615,"radius_m":100},{"name":"MATF 2","latitude":44.803735279889494,"longitude":20.495233662987637,"radius_m":100},{"name":"MATF 3","latitude":44.80004520753084,"longitude":20.48487938340236,"radius_m":100}]
MOBILE_AUTH_SESSION_DAYS=30
